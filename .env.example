# Django Settings
SECRET_KEY=replace-with-a-secure-random-50-char-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app

# Database (Leave empty for SQLite in dev or set Postgres URL for production)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# CORS & CSRF
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://your-domain.com

# SSL / HTTPS Security (Set to True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
